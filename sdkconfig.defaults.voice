# AMOLED and LCD local voice control. WakeNet listens for the stock "Hi ESP"
# model and MultiNet5 Q8 recognizes a small English command grammar after
# wake-up. Two equally sized OTA slots retain safe A/B updates.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_voice.csv"
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_EN_MULTINET5_SINGLE_RECOGNITION_QUANT8=y
# WakeNet and MultiNet contain many small, PSRAM-safe working allocations.
# Prefer PSRAM for them so Wi-Fi and peripheral DMA keep enough internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
