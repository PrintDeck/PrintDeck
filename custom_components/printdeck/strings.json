{
  "title": "PrintDeck",
  "config": {
    "step": {
      "user": {
        "title": "Connect to PrintDeck",
        "description": "Enable Unified Printer API in [PrintDeck Web Config]({configuration_url}), then enter the local host and API token.",
        "data": {
          "host": "Host or IP address",
          "token": "Unified API token"
        },
        "data_description": {
          "host": "For example, printdeck.local or the local IP address shown by PrintDeck.",
          "token": "The token shown in Settings > Unified API in PrintDeck Web Config."
        }
      },
      "zeroconf_confirm": {
        "title": "Add discovered PrintDeck",
        "description": "{name} was found at `{host}`. Enable Unified Printer API in [PrintDeck Web Config]({configuration_url}) and enter its token.",
        "data": {
          "token": "Unified API token"
        }
      },
      "reauth_confirm": {
        "title": "Update the PrintDeck token",
        "description": "The current Unified API token was rejected. Enter the active token from PrintDeck Web Config.",
        "data": {
          "token": "Unified API token"
        }
      },
      "reconfigure": {
        "title": "Reconfigure PrintDeck",
        "description": "Update the local address or token. You can check them in [PrintDeck Web Config]({configuration_url}).",
        "data": {
          "host": "Host or IP address",
          "token": "Unified API token"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to PrintDeck.",
      "invalid_auth": "The Unified API token is not valid.",
      "api_disabled": "Unified Printer API is disabled. Enable it in PrintDeck Web Config.",
      "unsupported_firmware": "Update PrintDeck firmware to a version that supports the Home Assistant integration.",
      "invalid_response": "PrintDeck returned an invalid response.",
      "invalid_input": "Enter a valid local host and API token.",
      "unknown": "An unexpected error occurred."
    },
    "abort": {
      "already_configured": "This PrintDeck is already configured.",
      "invalid_discovery": "The discovered service did not include a valid PrintDeck identity.",
      "reauth_successful": "The PrintDeck token was updated.",
      "reconfigure_successful": "PrintDeck was reconfigured."
    }
  },
  "entity": {
    "binary_sensor": {
      "online": {"name": "Connection"},
      "selected": {"name": "Selected printer"},
      "data_stale": {"name": "Stale data"}
    },
    "sensor": {
      "phase": {
        "name": "Print phase",
        "state": {
          "unknown": "Unknown", "idle": "Idle", "preparing": "Preparing", "printing": "Printing", "paused": "Paused", "completed": "Completed", "failed": "Failed", "cancelled": "Cancelled"
        }
      },
      "activity": {
        "name": "Printer activity",
        "state": {
          "unknown": "Unknown", "standby": "Standby", "preparing": "Preparing", "nozzle_heating": "Heating nozzle", "bed_heating": "Heating bed", "homing": "Homing", "bed_leveling": "Bed leveling", "nozzle_cleaning": "Cleaning nozzle", "calibrating": "Calibrating", "filament_changing": "Changing filament", "filament_unloading": "Unloading filament", "filament_loading": "Loading filament", "filament_purging": "Purging filament", "printing": "Printing", "paused": "Paused", "completed": "Completed", "failed": "Failed", "cancelled": "Cancelled"
        }
      },
      "progress": {"name": "Print progress"},
      "job_name": {"name": "Print name"},
      "job_kind": {"name": "Job type", "state": {"print": "Print", "calibration": "Calibration"}},
      "remaining_time": {"name": "Remaining time"},
      "elapsed_time": {"name": "Elapsed time"},
      "current_layer": {"name": "Current layer"},
      "total_layers": {"name": "Total layers"},
      "nozzle_temperature": {"name": "Nozzle temperature"},
      "nozzle_target_temperature": {"name": "Nozzle target temperature"},
      "bed_temperature": {"name": "Bed temperature"},
      "bed_target_temperature": {"name": "Bed target temperature"},
      "chamber_temperature": {"name": "Chamber temperature"},
      "connection_state": {
        "name": "Connection state",
        "state": {"unknown": "Unknown", "stopped": "Stopped", "waiting_for_network": "Waiting for network", "connecting": "Connecting", "online": "Online", "offline": "Offline"}
      },
      "reachability": {"name": "Reachability", "state": {"unknown": "Unknown", "online": "Online", "offline": "Offline"}},
      "detail_level": {"name": "Data detail", "state": {"summary": "Summary", "full": "Full"}}
    }
  }
}
